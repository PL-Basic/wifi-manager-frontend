# 将 wifi.example.com 和证书路径替换为真实生产配置。
# 构建后的 dist 内容部署到 /var/www/wifi-manager。

server {
    listen 80;
    listen [::]:80;
    server_name wifi.example.com;

    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name wifi.example.com;

    ssl_certificate /etc/letsencrypt/live/wifi.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/wifi.example.com/privkey.pem;

    root /var/www/wifi-manager;
    index index.html;
    client_max_body_size 3m;

    # /api 前缀只属于浏览器入口，转发到 Gateway 时去掉该前缀。
    location /api/ {
        proxy_pass http://127.0.0.1:8080/;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # 外部请求不能携带服务间可信身份头。
        proxy_set_header X-Gateway-Token "";
        proxy_set_header X-Internal-Token "";
        proxy_set_header X-User-Id "";
        proxy_set_header X-User-Name "";
        proxy_set_header X-User-Role "";
    }

    # 保留 /ws/alerts 原始路径，并完成 WebSocket Upgrade。
    location /ws/ {
        proxy_pass http://127.0.0.1:8080;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        proxy_set_header X-Gateway-Token "";
        proxy_set_header X-Internal-Token "";
        proxy_set_header X-User-Id "";
        proxy_set_header X-User-Name "";
        proxy_set_header X-User-Role "";

        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
    }

    location /assets/ {
        try_files $uri =404;
        expires 7d;
        add_header Cache-Control "public, immutable";
    }

    # Vue Router history 模式需要把未知页面路径交回 index.html。
    location / {
        try_files $uri $uri/ /index.html;
    }
}
