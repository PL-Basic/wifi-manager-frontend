# 浏览器运行配置。正式部署推荐保持同源相对路径。
VITE_API_BASE_URL=/api
VITE_ALERT_WS_PATH=/ws/alerts
# 只有跨域部署时才填写完整 ws:// 或 wss:// 地址；留空使用当前页面域名。
VITE_ALERT_WS_URL=

# 地图 Provider：none、amap 或 xyz。高德 Web JS API 需要同时填写 Key 和安全密钥。
VITE_MAP_PROVIDER=none
VITE_AMAP_KEY=
VITE_AMAP_SECURITY_JS_CODE=

# xyz 仅用于持有明确授权的 HTTPS 瓦片服务，不要填写高德 Web JS API Key。
VITE_MAP_TILE_URL=
VITE_MAP_ATTRIBUTION=

# 以下变量只控制 Vite 本地开发服务器，不会进入 dist。
# 默认只监听本机；局域网联调时可在本机 .env 中改为 0.0.0.0。
WIFI_DEV_HOST=127.0.0.1
WIFI_DEV_PORT=5173
WIFI_DEV_ALLOWED_HOSTS=portal.test
WIFI_DEV_GATEWAY_HTTP_TARGET=http://localhost:8080
WIFI_DEV_GATEWAY_WS_TARGET=ws://localhost:8080
